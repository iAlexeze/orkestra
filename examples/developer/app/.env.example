# .env — copy this to .env and fill in your values
#
# Lines tagged  # ork:cfg  become a ConfigMap (safe to log, not secret)
# All other lines become a Kubernetes Secret (encrypted at rest)

APP_NAME=my-api   # ork:cfg
PORT=8080         # ork:cfg

# --- Secrets (remove the # to activate) -------------------------

# DATABASE_URL=postgres://user:pass@host:5432/db

# --- SMTP (for --notify-me in example 04) -------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@example.com

# --- Slack (for --notify-me in example 04) ------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

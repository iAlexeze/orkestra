# ------------------------------------------------------------------------------
# Orkestra / Konduktor Core
# ------------------------------------------------------------------------------

# Version and environment
ORK_VERSION=1.0.0
ORK_ENV=development          # development | staging | production
LOG_LEVEL=info               # debug | info | warn | error | fatal

# ------------------------------------------------------------------------------
# Kubernetes Cluster Configuration
# ------------------------------------------------------------------------------

# Path to kubeconfig (ignored when IN_CLUSTER=true)
KUBEKONFIG=/home/${USER}/.kube/config

# API server override (rarely needed)
MASTER_URL=

# Run inside Kubernetes (true/false)
IN_CLUSTER=false

# Cluster identity
CLUSTER_NAME=kubernetes-crd-example
NAMESPACE=default            # Default namespace for reconcilers

# Workload defaults
DEFAULT_RESYNC=15            # Seconds; default resync period for all CRDs
DEFAULT_WORKERS=3            # Default worker count per CRD

# ------------------------------------------------------------------------------
# Health Server
# ------------------------------------------------------------------------------

HEALTH_PORT=5000             # Port for /health, /ready and /metrics
SRV_READ_TIMEOUT=5           # Seconds
SRV_WRITE_TIMEOUT=20         # Seconds

# ------------------------------------------------------------------------------
# Konductor Leader Election
# ------------------------------------------------------------------------------

LEADER_ELECTION_NAMESPACE=default
LEASE_DURATION=60            # Seconds; total lease duration
RENEW_DEADLINE=40            # Seconds; must be < LEASE_DURATION
RETRY_PERIOD=10              # Seconds; retry interval for leader election

# ------------------------------------------------------------------------------
# Katalog / Komposer Configuration
# ------------------------------------------------------------------------------

# Paths to Katalog or Komposer files (comma-separated or single path)
# Can be overridden with --katalog flag
KATALOG_PATH=./katalog.yaml

# Default queue depth and degrade threshold for CRDs
MAX_QUEUE_DEPTH=2000
DEGRADE_THRESHOLD=5

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
# - All values can be overridden by CLI flags.
# - KATALOG_PATH supports remote URLs when using authenticated sources.
# - IN_CLUSTER=true disables KUBEKONFIG and MASTER_URL.
# - FINALIZER should be unique per installation.
# - DEFAULT_RESYNC and DEFAULT_WORKERS apply only when not set per CRD.

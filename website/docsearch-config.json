{
  "index_name": "orkestra",
  "start_urls": ["https://orkestra.sh/docs/"],
  "sitemap_urls": ["https://orkestra.sh/sitemap.xml"],
  "stop_urls": [],
  "selectors": {
    "lvl0": {
      "selector": ".sidebar-section.open .sidebar-section-link",
      "global": true,
      "default_value": "Documentation"
    },
    "lvl1": "article.docs-content h1.docs-title",
    "lvl2": "article.docs-content .docs-body h2",
    "lvl3": "article.docs-content .docs-body h3",
    "lvl4": "article.docs-content .docs-body h4",
    "text": "article.docs-content .docs-body p, article.docs-content .docs-body li"
  },
  "selectors_exclude": [
    ".docs-pagination",
    ".docs-meta",
    "nav"
  ],
  "strip_chars": " .,;:#",
  "custom_settings": {
    "attributesForFaceting": ["language", "version"]
  },
  "min_indexed_level": 1
}

{
  "title": "{{ .CRD.Kind }} Controller",
  "uid": "{{ .CRD.Name }}-controller",
  "schemaVersion": 36,
  "panels": [
    {
      "type": "gauge",
      "title": "Queue Depth",
      "targets": [
        { "expr": "orkestra_queue_depth{crd=\"{{ .CRD.Name }}\"}" }
      ]
    },
    {
      "type": "stat",
      "title": "Health Status",
      "targets": [
        { "expr": "orkestra_health_status{crd=\"{{ .CRD.Name }}\"}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reconcile Duration (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(orkestra_reconcile_duration_seconds_bucket{crd=\"{{ .CRD.Name }}\"}[5m])) by (le))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reconcile Errors",
      "targets": [
        { "expr": "rate(orkestra_reconcile_total{status=\"error\",crd=\"{{ .CRD.Name }}\"}[5m])" }
      ]
    }
  ]
}
